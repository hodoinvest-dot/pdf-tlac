{
  "name": "PDF Tlač",
  "short_name": "PDF Tlač",
  "description": "Otvor PDF, Word alebo Excel, píš a vytlač. Funguje aj bez internetu.",
  "lang": "sk",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1f5eff",
  "theme_color": "#1f5eff",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "pdf",
          "accept": [
            "application/pdf",
            ".pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx",
            "application/vnd.ms-excel",
            ".xls",
            "text/csv",
            ".csv"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "PDF · PDF Tlač",
      "short_name": "PDF",
      "url": "./pdf/",
      "icons": [
        {
          "src": "pdf/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Word · PDF Tlač",
      "short_name": "Word",
      "url": "./word/",
      "icons": [
        {
          "src": "word/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Excel · PDF Tlač",
      "short_name": "Excel",
      "url": "./excel/",
      "icons": [
        {
          "src": "excel/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Poznámky · PDF Tlač",
      "short_name": "Poznámky",
      "url": "./poznamky/",
      "icons": [
        {
          "src": "poznamky/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}